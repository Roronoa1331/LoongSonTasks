_RamSize = DEFINED(_RamSize) ? _RamSize : 64M;
_StackSize = DEFINED(_StackSize) ? _StackSize : 0x4000;

OUTPUT_ARCH(mips)
ENTRY(start)

MEMORY
{
    ram (wx) : ORIGIN = 0x80000000, LENGTH = 64M
}

SECTIONS
{
    .text 0x80200000 :
    {
        _ftext = ABSOLUTE(.);
        *(.text*)
        _ecode = ABSOLUTE(.);
        *(.rodata*)
        . = ALIGN(4);
        _etext = ABSOLUTE(.);
    } > ram

    .eh_frame_hdr : { *(.eh_frame_hdr) *(.eh_frame_entry) }
    .eh_frame : ONLY_IF_RO { KEEP (*(.eh_frame)) }

    .data :
    {
        _fdata = ABSOLUTE(.);
        *(.data*)
        *(.gcc_except_table*)
        . = ALIGN(4);
        __CTOR_LIST__ = ABSOLUTE(.);
        KEEP(*(SORT(.ctors*)))
        __CTOR_END__ = ABSOLUTE(.);
        __DTOR_LIST__ = ABSOLUTE(.);
        KEEP(*(SORT(.dtors*)))
        __DTOR_END__ = ABSOLUTE(.);
        . = ALIGN(4);
        _gp = ABSOLUTE(. + 0x7ff0);
        *(.lit8)
        *(.lit4)
        *(.sdata)
        . = ALIGN(4);
        _edata = ABSOLUTE(.);
    } > ram

    . = ALIGN(4);
    _fbss = .;
    .sbss : { *(.sbss) *(.scommon) }
    .bss :
    {
        *(.bss)
        *(COMMON)
        . = ALIGN(4);
        _stack_start = .;
        . += _StackSize;
        _stack_end = .;
        _freemem = .;
    } > ram

    _end = .;

    /* Top of the 64 MB RAM window: newlib's heap may grow up to here. */
    _heap_limit = ORIGIN(ram) + LENGTH(ram);

    /DISCARD/ :
    {
        *(.reginfo)
    }

    PROVIDE(etext = _etext);
    PROVIDE(edata = .);
    PROVIDE(end = .);
}
