#
# makefile.init
# ---------------------------------------------------------------------------
# User extension hook that Build/Makefile.mk includes at the very top
# ("-include ../makefile.init").  It is NOT generated by LoongIDE, so the
# content here survives a "Project -> Open Project" or a rebuild of the
# generated makefiles.
#
# Why this line is needed:
#   Every *.d dependency file that the compiler writes (-MMD -MP) contains a
#   rule whose target is the *.d file itself.  Those files are included by
#   Makefile.mk, so as soon as the project has been built once, GNU make would
#   adopt the first such rule as its default goal and a plain
#       make -f Makefile.mk
#   would answer "Nothing to be done for `main.d'" instead of rebuilding.
# ---------------------------------------------------------------------------

.DEFAULT_GOAL := all
